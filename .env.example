# Dùng cho docker compose. Copy thành .env rồi sửa (trên Windows: windows\1-khoi-dong.bat tự tạo file này).

# Chuỗi bí mật ngẫu nhiên, dài ít nhất 32 ký tự (gõ bừa cũng được, KHÔNG chia sẻ cho ai)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai-it-nhat-32-ky-tu

# Tài khoản quản trị tạo ở lần chạy đầu tiên
ADMIN_EMAIL=admin@checklive.local
ADMIN_PASSWORD=doi-mat-khau-nay

# Mã Cloudflare Tunnel (Cloudflare Zero Trust > Networks > Tunnels > tạo tunnel > chọn Docker > copy phần sau "--token")
# Bỏ trống nếu chỉ dùng trên máy này (http://localhost:3000)
TUNNEL_TOKEN=

# Không bắt buộc: API key Euler Stream giúp kết nối TikTok ổn định hơn
EULER_API_KEY=
FB_GRAPH_VERSION=v26.0
