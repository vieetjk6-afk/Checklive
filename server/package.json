{
  "name": "@checklive/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/jwt": "10.2.7",
    "@fastify/static": "10.1.10",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "socket.io": "4.8.4",
    "tiktok-live-connector": "2.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
