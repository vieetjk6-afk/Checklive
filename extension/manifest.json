{
  "manifest_version": 3,
  "name": "Checklive Connector",
  "version": "0.1.0",
  "description": "Gửi bình luận live Facebook (trang cá nhân, Group, Fanpage) về Checklive để thống kê, chốt đơn và chơi game.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["fb-extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Checklive Connector",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
